PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Database mode:
# auto = use Supabase if credentials exist, otherwise local JSON
# supabase = require Supabase and fail fast if credentials are missing
# local = use data/db.json only
DATABASE_MODE=auto
SUPABASE_URL=
# Use service_role secret key here. Do not use sb_publishable_*.
SUPABASE_SERVICE_ROLE_KEY=

# SePay QR information. Use the bank short code from https://qr.sepay.vn/banks.json
SEPAY_BANK_CODE=Vietcombank
SEPAY_ACCOUNT_NUMBER=0010000000355
SEPAY_ACCOUNT_NAME=TEN CHU TAI KHOAN
PAYMENT_CODE_PREFIX=GS
ORDER_EXPIRE_MINUTES=15
ALLOW_OVERPAY=true
# true only for customer demo links without real bank transfer. Set false in production.
DEMO_PAYMENT_ENABLED=false

# Webhook security. Production should use hmac.
# none | apikey | hmac
SEPAY_AUTH_MODE=hmac
SEPAY_API_KEY=change_this_if_using_apikey
SEPAY_WEBHOOK_SECRET=change_this_if_using_hmac

# Simple admin token for test endpoints and order monitoring.
ADMIN_TOKEN=change_this_admin_token
